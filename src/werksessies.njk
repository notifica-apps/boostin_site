        </div>
      </div>
      <div class="np-lane ws-type">
        <span class="ws-type-num">03</span>
        <h3>Adviserende MT-werksessie</h3>
        <span class="ws-type-sub">Samenbrengen, adviseren en besluiten</span>
        <span class="ws-type-label">Doel</span>
