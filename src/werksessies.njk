<script>
  // Inladen bij scrollen voor de pagina-eigen .ws-reveal elementen.
  // Zelfde gedrag en vangnetten als /assets/js/reveal.js.
  (function () {
    "use strict";
    var els = Array.prototype.slice.call(document.querySelectorAll(".ws-reveal"));
    if (!els.length) return;
    function showAll() {
      for (var i = 0; i < els.length; i++) els[i].classList.add("is-visible");
    }
    try {
      if (!("IntersectionObserver" in window)) { showAll(); return; }
      var STAGGER_PARENTS = ".ws-route, .ws-arch";
      els.forEach(function (el) {
        var group = el.closest(STAGGER_PARENTS);
        if (!group) return;
        var i = Array.prototype.slice.call(group.children).indexOf(el);
        if (i > 0) el.style.setProperty("--reveal-delay", Math.min(i, 5) * 80 + "ms");
      });
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
      els.forEach(function (el) { observer.observe(el); });
    } catch (e) {
      showAll();
    }
  })();
</script>
