---
layout: base.njk
title: Van workshop naar implementatiewerksessie
description: "Boostin-werksessies zijn geen losse workshops, maar onderdeel van een vaste, leerbare en schaalbare implementatiemethodiek. Vier typen werksessies, één architectuur: van richting bepalen tot borging in de praktijk."
permalink: /werksessies/
pageCss: /assets/css/niche.css
bodyClass: page-werksessies
---

<style>
  /* ------------------------------------------------------------------------
     Werksessies / implementatiemethodiek — pagina-eigen aanvullingen op het
     np-designsysteem. Donkere secties in #4A3A46 (voorkeurskleur briefing);
     rood blijft het accent, blauw/groen komen alleen terug in de
     veranderkunde-sectie omdat ze daar inhoud zijn (kleurendenken).
     ------------------------------------------------------------------------ */
  .page-werksessies {
    --ws-ink: #4a3a46;
    --ws-ink-2: #574450;
  }

  .page-werksessies .np-section--ink,
  .page-werksessies .np-cta,
  .page-werksessies .np-panel--red {
    background: linear-gradient(150deg, var(--ws-ink-2) 0%, var(--ws-ink) 100%);
  }

  .page-werksessies .np-section--ink .np-tag {
    color: #ff5c82;
  }

  .page-werksessies .np-cta-note {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Hero — licht, veel wit, aubergine alleen als tint */
  .ws-hero {
    position: relative;
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background:
      radial-gradient(56rem 30rem at 100% 0, rgba(74, 58, 70, 0.08), transparent 60%),
      radial-gradient(44rem 26rem at 0 100%, rgba(255, 20, 79, 0.05), transparent 55%),
      #fff;
    border-bottom: 1px solid var(--np-line);
  }

  .ws-hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 4.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--np-heading);
  }

  .ws-hero-sub {
    margin: 0 0 1.375rem;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--np-heading);
  }

  .ws-hero-sub i {
    font-style: normal;
    padding-inline: 0.5rem;
    color: var(--np-red);
  }

  .ws-hero-lead {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1rem, 1.3vw, 1.0625rem);
    line-height: 1.8;
    color: var(--np-text);
  }

  .ws-kernzin {
    margin: 1.75rem 0 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--np-red);
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--np-heading);
  }

  .ws-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.25rem;
  }

  .ws-hero-note {
    margin: 1.5rem 0 0;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--np-text-dim);
  }

  /* Architectuurketen in de hero: lichte variant van de np-chain */
  .ws-chain {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--np-line);
    border-radius: var(--np-radius-lg);
    box-shadow: 0 1px 2px rgba(25, 21, 24, 0.05), 0 30px 70px -35px rgba(25, 21, 24, 0.3);
  }

  .ws-chain h2 {
    margin: 0 0 0.3rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.005em;
    color: var(--np-heading);
  }

  .ws-chain > p {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    color: var(--np-text-dim);
  }

  .ws-chain ol {
    position: relative;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .ws-chain ol::before {
    content: '';
    position: absolute;
    top: 0.9rem;
    bottom: 0.9rem;
    left: 4px;
    width: 1px;
    background: linear-gradient(to bottom, var(--np-line) 0%, var(--np-red) 100%);
  }

  .ws-chain li {
    position: relative;
    padding: 0.375rem 0;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--np-heading);
  }

  .ws-chain li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -1.75rem;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    background: #fff;
    border: 1px solid var(--np-text-dim);
    border-radius: 50%;
  }

  .ws-chain li:last-child::before {
    background: var(--np-red);
    border-color: var(--np-red);
  }

  /* Horizontale proceslijn: pills met pijlen, wrapt netjes op mobiel */
  .ws-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ws-flow li {
    display: inline-flex;
    align-items: center;
  }

  .ws-flow li span {
    padding: 0.5625rem 1.0625rem;
    background: var(--np-surface);
    border: 1px solid var(--np-line);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--np-heading);
    white-space: nowrap;
  }

  .ws-flow li:not(:last-child)::after {
    content: '\2192';
    padding-inline: 0.625rem;
    font-weight: 700;
    color: var(--np-red);
  }

  .ws-flow--center { justify-content: center; }

  .ws-flow--sm li span {
    padding: 0.4375rem 0.875rem;
    font-size: 0.8125rem;
  }

  .ws-flow--sm li:not(:last-child)::after { padding-inline: 0.4375rem; }

  .ws-flow--onsurface li span { background: #fff; }

  .ws-flow--ink li span {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .ws-flow--ink li:not(:last-child)::after { color: #ff5c82; }

  .ws-flow--tight { margin-top: 0.5rem; }

  /* Vier typen werksessies — kaarten op basis van np-lane */
  .ws-type { display: flex; flex-direction: column; }

  .ws-type-num {
    display: block;
    margin-bottom: 0.875rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--np-line-soft);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--np-red-ink);
  }

  .ws-type h3 { margin: 0 0 0.125rem; }

  .ws-type-sub {
    display: block;
    margin-bottom: 1.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--np-text-dim);
  }

  .ws-type-label {
    display: block;
    margin: 1.25rem 0 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--np-text-dim);
  }

  .ws-type .ws-type-label:first-of-type { margin-top: 0; }

  .ws-type h4 {
    margin: 1.25rem 0 0.375rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--np-heading);
  }

  .ws-type h4 span {
    font-weight: 400;
    color: var(--np-text-dim);
  }

  .ws-type .np-checks { margin-top: 0.25rem; }

  .ws-type .np-pills { margin-top: 0.375rem; }

  .ws-result {
    margin-top: 1.5rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--np-line-soft);
  }

  .ws-result .ws-type-label { margin: 0 0 0.25rem; color: var(--np-red-ink); }

  .ws-result p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--np-heading);
  }

  /* Leer- en implementatieroute — donkere sectie met vier stappen */
  .ws-route {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    counter-reset: ws-route;
  }

  .ws-route-step {
    position: relative;
    padding: clamp(1.5rem, 2.4vw, 1.875rem);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--np-radius);
    counter-increment: ws-route;
  }

  .ws-route-step::before {
    content: '0' counter(ws-route);
    display: block;
    margin-bottom: 0.875rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #ff5c82;
  }

  .ws-route-step h3 {
    margin: 0 0 0.625rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .ws-route-chip {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.3125rem 0.6875rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.9);
  }

  .ws-route-step p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.66);
  }

  .ws-route-step:not(:last-child)::after {
    content: '\2192';
    position: absolute;
    top: 50%;
    right: -0.625rem;
    transform: translate(50%, -50%);
    z-index: 1;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--np-red);
  }

  /* Vaste architectuur — acht genummerde stappen */
  .ws-arch {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: ws-arch;
  }

  .ws-arch-step {
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--np-line);
    border-radius: var(--np-radius);
    counter-increment: ws-arch;
  }

  .ws-arch-step::before {
    content: '0' counter(ws-arch);
    display: block;
    margin-bottom: 0.875rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--np-line-soft);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--np-red-ink);
  }

  .ws-arch-step h3 {
    margin: 0 0 0.375rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.005em;
    color: var(--np-heading);
  }

  .ws-arch-step p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--np-text);
  }

  /* Tijdlijn van vier uur */
  .ws-timeline {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .ws-timeline::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: calc(8.875rem + 8px);
    width: 1px;
    background: var(--np-line);
  }

  .ws-tl-row {
    position: relative;
    display: grid;
    grid-template-columns: 7.75rem 18px minmax(0, 1fr);
    column-gap: 1.125rem;
    padding-block: 1.125rem;
  }

  .ws-tl-time {
    padding-top: 0.1rem;
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
    color: var(--np-text-dim);
  }

  .ws-tl-dot { position: relative; }

  .ws-tl-dot::after {
    content: '';
    position: absolute;
    top: 0.375rem;
    left: 50%;
    width: 11px;
    height: 11px;
    transform: translateX(-50%);
    background: #fff;
    border: 2px solid var(--np-red);
    border-radius: 50%;
  }

  .ws-tl-row h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.005em;
    color: var(--np-heading);
  }

  .ws-tl-row p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--np-text);
  }

  .ws-tl-row--pauze h3 { color: var(--np-text-dim); }
  .ws-tl-row--pauze .ws-tl-dot::after { border-color: var(--np-line); }

  /* Voorbeeldwerksessie: documentkaart op de donkere sectie */
  .ws-doc {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ws-doc-label {
    margin: 1.375rem 0 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--np-red-ink);
  }

  .ws-doc-label:first-child { margin-top: 0; }

  .ws-doc p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--np-text);
  }

  .ws-template {
    margin-top: 0.5rem;
    overflow-x: auto;
    border: 1px solid var(--np-line);
    border-radius: var(--np-radius);
  }

  .ws-template table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .ws-template th {
    padding: 0.75rem 0.875rem;
    background: var(--np-surface);
    border-bottom: 1px solid var(--np-line);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
    color: var(--np-text-dim);
  }

  .ws-template td {
    padding: 0.875rem;
    border-bottom: 1px solid var(--np-line-soft);
    vertical-align: top;
    line-height: 1.5;
    color: var(--np-heading);
  }

  .ws-template td:first-child { font-weight: 600; }
  .ws-template tr:last-child td { border-bottom: 0; }
  .ws-template .is-ghost td { font-style: italic; color: var(--np-text-dim); }

  .ws-doc-result {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--np-line-soft);
  }

  /* Checklijsten in twee kolommen */
  .ws-checks-cols {
    margin-top: 0.75rem;
    columns: 2;
    column-gap: 2.5rem;
  }

  /* de kaart staat op een ink-sectie die color:#fff zet; zonder eigen kleur
     erven de items wit en zijn ze onzichtbaar op de witte kaart */
  .ws-checks-cols li {
    break-inside: avoid;
    color: var(--np-text);
  }

  /* Gecentreerde sectiekop: de standaard np-head (kop links, tekst rechts)
     oogt uit balans bij een korte tekst naast een hoge kop; deze sectie is
     één gecentreerde kolom met chips en slotzin eronder */
  .ws-head-center {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .ws-head-center p { max-width: 38rem; }

  /* Grote slotzin */
  .ws-big {
    max-width: 40rem;
    margin: clamp(2.5rem, 4vw, 3.5rem) auto 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.6vw, 2.625rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-align: center;
    color: var(--np-heading);
  }

  /* Veranderkunde: blauw (structuur) en groen (leren) rond Action Learning */
  .ws-al {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  .ws-al-badge {
    align-self: center;
    justify-self: center;
    padding: 0.8125rem 1.5rem;
    background: linear-gradient(150deg, var(--ws-ink-2), var(--ws-ink));
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.005em;
    white-space: nowrap;
    color: #fff;
    box-shadow: 0 12px 30px -12px rgba(74, 58, 70, 0.5);
  }

  .ws-panel--blauw { border-top: 3px solid #3177ea; }
  .ws-panel--groen { border-top: 3px solid #2f8f6b; }

  .ws-panel-kicker {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .ws-panel--blauw .ws-panel-kicker { color: #2560c7; }
  .ws-panel--groen .ws-panel-kicker { color: #24785a; }
  .ws-panel--blauw .np-checks li::before { border-color: #2560c7; }
  .ws-panel--groen .np-checks li::before { border-color: #24785a; }

  .ws-al-note {
    max-width: 44rem;
    margin: 2rem auto 0;
    font-size: 0.9375rem;
    line-height: 1.8;
    text-align: center;
    color: var(--np-text);
  }

  /* Kernzin in donker paneel (train-de-trainer) */
  .ws-panel-kernzin {
    margin: 1.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #fff;
  }

  /* Schaalbaarheidsvisual */
  .ws-scale { text-align: center; }

  .ws-scale-src {
    display: inline-block;
    padding: 0.8125rem 1.75rem;
    background: linear-gradient(150deg, var(--ws-ink-2), var(--ws-ink));
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.005em;
    color: #fff;
  }

  /* verbindingspijl die de bron-pill en de tray echt raakt (display:block,
     want op een inline span doen width/height niets) */
  .ws-scale-arrow {
    position: relative;
    display: block;
    width: 1px;
    height: 2rem;
    margin: 0 auto;
    background: var(--np-red);
  }

  .ws-scale-arrow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--np-red);
  }

  /* de toepassingen als één omkaderd geheel, geen zwevende chips */
  .ws-scale-tray {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--np-line);
    border-radius: var(--np-radius-lg);
  }

  .ws-scale-apps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* tags in de stijl van np-pills, geen knoppen */
  .ws-scale-apps li {
    padding: 0.4375rem 0.9375rem;
    background: var(--np-surface);
    border: 1px solid var(--np-line);
    border-radius: 9px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--np-text);
  }

  .ws-scale-apps li.ws-etc {
    background: transparent;
    border-color: transparent;
    color: var(--np-text-dim);
  }

  /* Partners */
  .ws-partner-note {
    margin: 1.75rem 0 0;
    font-size: 0.9375rem;
    color: var(--np-text);
  }

  .ws-partner-note a {
    font-weight: 600;
    color: var(--np-red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Slot-CTA */
  .ws-cta-kernzin {
    max-width: 34rem;
    margin: 2.25rem auto 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: #fff;
  }

  .ws-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .ws-cta-actions .btn { margin-top: 0; }

  /* Inladen bij scrollen, zelfde patroon als main.css/reveal.js */
  .ws-reveal {
    transition:
      opacity 0.7s var(--ease) var(--reveal-delay, 0ms),
      transform 0.7s var(--ease) var(--reveal-delay, 0ms);
  }

  .ws-reveal:not(.is-visible) {
    opacity: 0;
    transform: translateY(18px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ws-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
