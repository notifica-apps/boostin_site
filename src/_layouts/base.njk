<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">

  {% if site.analytics.ga4 %}
  <!--
    Google tag (gtag.js) met Consent Mode v2.

    Deze staat bewust hier in de HTML en niet achter de cookiebanner: Google
    moet de tag kunnen vinden, anders faalt de tagcontrole in GA4 ("Uw
    Google-tag is niet gevonden"). Gemeten wordt er pas na toestemming -- tot
    die tijd staat alles op "denied", dus geen cookies en geen identifiers.
    cookie-consent.js zet dit bij "Accepteren" om naar "granted".
  -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    // Alleen de productiesite telt mee. Preview-deploys op *.pages.dev en de
    // dev-server draaien dezelfde HTML met hetzelfde meet-ID; ga-disable legt
    // de tag daar helemaal stil, terwijl het script-element in de pagina blijft.
    if (['boostin.nl', 'www.boostin.nl'].indexOf(location.hostname) === -1) {
      window['ga-disable-{{ site.analytics.ga4 }}'] = true;
    }

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500
    });

    // Eerder al akkoord gegeven? Dan meteen bij de eerste hit meten in plaats
    // van te wachten tot cookie-consent.js onder in de pagina geladen is.
    // Let op: sleutel en versie staan ook in cookie-consent.js. Hoog je daar
    // CONSENT_VERSION op, pas het hier dan mee aan.
    try {
      var boostinConsent = JSON.parse(localStorage.getItem('boostin_cookie_consent') || 'null');
      if (boostinConsent && boostinConsent.version === '1' && boostinConsent.analytics) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    } catch (e) {}

    gtag('js', new Date());
    gtag('config', {{ site.analytics.ga4 | dump | safe }});
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"></script>
  {% endif %}

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600;7..72,700&family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet">
  <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}</style></noscript>

  <!-- Styles -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  {% if pageCss %}<link rel="stylesheet" href="{{ pageCss | url }}">{% endif %}

  <!-- Favicon & Apple Touch Icon -->
  <link rel="icon" type="image/png" href="{{ '/assets/images/favicon.png' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/favicon.png' | url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="nl_NL">
  <meta property="og:image" content="{{ site.url }}/assets/images/boostin-og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.name }} - {{ site.tagline }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | {{ site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/boostin-og-image.jpg">
  <meta name="twitter:image:alt" content="{{ site.name }} - {{ site.tagline }}">

  <!-- Schema.org Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/images/boostin-logo.svg",
    "sameAs": [
      "{{ site.social.linkedin }}"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Service",
      "telephone": "{{ site.phone }}",
      "email": "{{ site.email }}",
      "availableLanguage": ["Dutch"]
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.city }}",
      "postalCode": "{{ site.address.postal }}",
      "addressCountry": "NL"
    },
    "parentOrganization": {
      "@type": "Organization",
      "name": "{{ site.parent }}"
    }
  }
  </script>

  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass or '' }}">
  {% include "header.njk" %}

  <main>
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>

  {% include "footer.njk" %}

  <!-- Scripts -->
  <script src="{{ '/assets/js/mobile-nav.js' | url }}"></script>
  <script src="{{ '/assets/js/contact-form.js' | url }}"></script>
  <script src="{{ '/assets/js/reveal.js' | url }}"></script>

  <!--
    Cookie consent. De meet-ID's komen uit src/_data/site.json onder "analytics".
    Staat daar niets ingevuld, dan verschijnt er geen banner en wordt er geen
    enkele tracker geladen.
  -->
  <script>
    window.BOOSTIN_CONSENT_CONFIG = {
      ga4: {{ (site.analytics.ga4 or null) | dump | safe }},
      clarity: {{ (site.analytics.clarity or null) | dump | safe }},
      linkedinPartnerId: {{ (site.analytics.linkedinPartnerId or null) | dump | safe }},
      linkedinConversions: {{ (site.analytics.linkedinConversions or {}) | dump | safe }},
      cookiePolicyUrl: {{ ('/cookies/' | url) | dump | safe }}
    };
  </script>
  <script src="{{ '/assets/js/cookie-consent.js' | url }}"></script>

  {% block scripts %}{% endblock %}
</body>
</html>
